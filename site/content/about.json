  "research": [
    {
      "kind": {
        "pt": "TCC · em andamento",
        "en": "Thesis · in progress"
      },
      "title": {
        "pt": "O design na construção da identidade, da comunidade e da experiência em festivais independentes de música no Brasil: um estudo sobre a cena alternativa brasileira, tomando o festival banda de casinha como estudo de caso",
        "en": "Design in the Construction of Identity, Community, and Experience at Independent Music Festivals in Brazil: A Study of the Brazilian Alternative Scene, Using the Banda de Casinha Festival as a Case Study"
      },
      "text": {
        "pt": "Projeto-ensaio que trata a cena musical independente e os festivais de banda de casinha de Belo Horizonte como objeto de análise, usando as lentes do design gráfico e do design de serviços para entender como esses eventos se organizam, se comunicam e criam comunidade.",
        "en": "An essay-project that takes Belo Horizonte's independent music scene and house-show festivals as its subject, using graphic design and service design to understand how these events organise, communicate and build community."
      },
      "link": ""
    },
    {
      "kind": {
        "pt": "Artigo · AEC&D, UFAM, 2023",
        "en": "Paper · AEC&D, UFAM, 2023"
      },
      "title": {
        "pt": "Acessibilidade em jogos digitais: análise de recursos para pessoas com baixa visão",
        "en": "Accessibility in video games: features for people with low vision"
      },
      "text": {
        "pt": "Com Larissa Zanetti Alves, Pedro Henrique Cristofori Simões Izelle e Priscilla Maria Cardoso Garone, a partir da pesquisa no LaDIJ/UFES. O artigo compara recursos de acessibilidade visual em jogos e identifica uma tendência crescente de adotá-los, como modos para daltonismo, alto contraste, HUD personalizável e elementos ampliados.",
        "en": "With Larissa Zanetti Alves, Pedro Henrique Cristofori Simões Izelle and Priscilla Maria Cardoso Garone, from research at LaDIJ/UFES. The paper compares visual accessibility features in games and finds a growing trend toward them, such as colour-blind modes, high contrast, customisable HUDs and enlarged elements."
      },
      "link": "https://periodicos.ufam.edu.br/index.php/dcae/article/view/12069"
    }
  ],
